---
import type { Project } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const Tag = project.href ? 'a' : 'article';
---

<Tag
  {...(project.href ? { href: project.href } : {})}
  class:list={['group block', { 'md:mt-24': project.offset }]}
>
  <div class="relative mb-6 aspect-[4/3] w-full overflow-hidden rounded-2xl bg-slate-200">
    <div class="absolute inset-0 bg-slate-300 transition-transform duration-700 ease-in-out group-hover:scale-105">
      <div class="flex h-full w-full items-center justify-center bg-[#E8E6E1]">
        <div class="h-32 w-32 rounded-full opacity-60 blur-2xl mix-blend-multiply" style={`background-color: ${project.colors[0]}`}></div>
        <div class="-ml-12 h-40 w-40 rounded-full opacity-60 blur-2xl mix-blend-multiply" style={`background-color: ${project.colors[1]}`}></div>
      </div>
    </div>
    <div class="absolute inset-0 bg-black/0 transition-colors duration-500 group-hover:bg-black/10"></div>
  </div>

  <div class="flex min-h-[5rem] items-start justify-between gap-4 border-t border-slate-300 pt-5">
    <div class="min-w-0">
      <h3 class="mb-1 text-3xl leading-none text-slate-900 md:text-4xl">{project.title}</h3>
      <p class="text-lg text-slate-500">{project.category}</p>
      <p class="mt-2 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">{project.note}</p>
    </div>

    <span class="mt-1 hidden shrink-0 items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-500 opacity-0 shadow-sm transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100 md:inline-flex md:translate-y-2">
      Case study soon
    </span>
  </div>
</Tag>
