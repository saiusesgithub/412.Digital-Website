---
import type { Service } from '../data/site';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<details class="group overflow-hidden border-b border-slate-300 py-8">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600 [&::-webkit-details-marker]:hidden">
    <span class="text-2xl font-semibold tracking-[0.08em] text-slate-400 transition-colors duration-300 group-hover:text-slate-900 group-open:text-slate-900 md:text-3xl">
      {service.title}
    </span>
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-slate-300 transition-all duration-300 group-hover:border-slate-900 group-hover:bg-slate-900 group-open:border-slate-900 group-open:bg-slate-900">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-stone-400 transition-all duration-300 group-hover:rotate-90 group-hover:text-white group-open:rotate-45 group-open:text-white">
        <path d="M5 12h14"></path>
        <path d="M12 5v14"></path>
      </svg>
    </span>
  </summary>

  <div class="grid grid-rows-[0fr] transition-all duration-500 ease-out group-hover:grid-rows-[1fr] group-open:grid-rows-[1fr]">
    <div class="overflow-hidden">
      <div class="max-w-2xl pt-4 opacity-0 transition-opacity delay-100 duration-500 group-hover:opacity-100 group-open:opacity-100">
        <p class="text-lg font-light leading-relaxed text-slate-600">{service.description}</p>
        <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs font-semibold uppercase tracking-[0.1em] text-cyan-700" aria-label={`${service.title.toLowerCase()} capabilities`}>
          {service.tags.map((tag) => <li>• {tag}</li>)}
        </ul>
      </div>
    </div>
  </div>
</details>
