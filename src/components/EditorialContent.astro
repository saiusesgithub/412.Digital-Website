---
import HowWeWork from './HowWeWork.astro';
import ProjectCard from './ProjectCard.astro';
import ServiceItem from './ServiceItem.astro';
import StudioSection from './StudioSection.astro';
import { projects, services } from '../data/site';
---

<section id="intro" class="relative z-20 -mt-1 bg-[#Fdfcf8] pb-20 pt-12 md:pb-32">
  <div class="mx-auto max-w-[90rem] px-5 sm:px-6 md:px-12">
    <div class="mx-auto mb-28 max-w-5xl scroll-mt-28 text-center md:mb-36">
      <p class="text-3xl font-medium leading-[1.15] tracking-tight text-slate-800 md:text-5xl">
        We’re an independent studio bringing
        <span class="serif text-4xl italic text-cyan-700 md:text-6xl"> technology, design and creative </span>
        together to help businesses build, launch and grow.
      </p>
    </div>

    <section id="work" aria-labelledby="work-heading" class="scroll-mt-28">
      <div class="mb-12 flex items-end justify-between gap-6 border-b border-slate-300 pb-6 md:mb-16">
        <div>
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-cyan-700">A growing body of work</p>
          <h2 id="work-heading" class="serif text-4xl italic text-slate-900 md:text-6xl">Selected Work</h2>
        </div>
        <p class="hidden max-w-xs text-right text-sm leading-relaxed text-slate-500 md:block">
          Real case studies will be added here as they are ready to share.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-x-12 gap-y-20 md:grid-cols-2 md:gap-y-32">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="services" aria-labelledby="services-heading" class="mb-20 mt-36 scroll-mt-28 md:mt-44">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
        <div class="flex flex-col items-start md:col-span-4">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-cyan-700">Capabilities</p>
          <h2 id="services-heading" class="serif mb-7 text-4xl italic text-slate-900 md:text-5xl">Build. Design. Grow.</h2>
          <p class="max-w-sm text-lg font-light leading-relaxed text-slate-600">
            Whatever the problem, we’ll figure out what needs to be built, designed or grown.
          </p>
          <a href="#contact" class="group mt-8 inline-flex items-center gap-3 rounded-full bg-slate-900 px-8 py-4 text-lg font-medium text-white shadow-lg transition-all duration-300 hover:bg-cyan-700 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-700">
            Start a Project
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1">
              <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <div class="flex flex-col md:col-span-8">
          {services.map((service) => <ServiceItem service={service} />)}
        </div>
      </div>
    </section>

    <HowWeWork />
    <StudioSection />
  </div>
</section>
