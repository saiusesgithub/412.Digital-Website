---
import { navigation, siteConfig } from '../data/site';
---

<header class="pointer-events-none absolute left-0 top-0 z-50 w-full">
  <nav aria-label="Primary navigation" class="adaptive-text pointer-events-auto mx-auto flex w-full max-w-[90rem] items-center justify-between px-5 py-6 sm:px-8 sm:py-8">
    <a href="#top" class="relative z-50 font-instrument-serif text-2xl italic text-amber-950 transition-opacity hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current">
      {siteConfig.name}
    </a>

    <div class="hidden items-center gap-8 text-green-950 md:flex lg:gap-10">
      {navigation.map((item) => (
        <a href={item.href} class="text-base font-medium transition-opacity hover:opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current lg:text-lg">
          {item.label}
        </a>
      ))}
    </div>

    <a href="#contact" class="hidden rounded-full border border-green-950 px-5 py-2 text-base font-medium text-amber-950 transition-colors hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current md:block lg:px-6 lg:text-lg">
      Start a Project
    </a>

    <button id="mobile-menu-btn" class="relative z-50 rounded-sm p-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current md:hidden" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
      <svg id="menu-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-opacity duration-300">
        <path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path>
      </svg>
      <svg id="close-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="absolute left-1 top-1 opacity-0 transition-opacity duration-300">
        <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
      </svg>
    </button>
  </nav>
</header>
