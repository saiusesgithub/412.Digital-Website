---
import { navigation, siteConfig, socialLinks } from '../data/site';
---

<footer id="contact" class="relative z-30 bg-[#Fdfcf8] px-3 pb-4 sm:px-4 md:px-6 md:pb-6">
  <div class="relative mx-auto flex w-full max-w-[90rem] flex-col items-center overflow-hidden rounded-[2rem] bg-[#07201D] px-5 py-16 text-center text-[#F0F7F6] shadow-2xl sm:rounded-[2.5rem] sm:px-6 md:rounded-[3.5rem] md:px-20 md:py-20">
    <div aria-hidden="true" class="mb-8 flex h-14 w-14 items-center justify-center rounded-full border border-cyan-300/20 text-cyan-300/70">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
      </svg>
    </div>

    <div class="mx-auto mb-16 max-w-5xl">
      <h2 class="font-instrument-serif text-4xl leading-[1.05] tracking-tight text-white sm:text-5xl md:text-7xl">Have something in mind?</h2>
      <p class="mx-auto mt-6 max-w-2xl text-base font-light leading-relaxed text-cyan-50/70 md:text-xl">
        Tell us what you're trying to build, improve or grow. We'll figure out the rest.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`mailto:${siteConfig.email}?subject=Project enquiry`} class="rounded-full bg-white px-7 py-3.5 text-sm font-bold text-[#07201D] transition-all hover:-translate-y-0.5 hover:bg-cyan-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">
          Start a Project
        </a>
        <a href={`mailto:${siteConfig.email}`} class="text-sm text-cyan-100/75 underline decoration-cyan-300/30 underline-offset-4 transition-colors hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">
          {siteConfig.email}
        </a>
      </div>
    </div>

    <div class="mb-12 h-px w-full max-w-6xl bg-white/10"></div>

    <div class="grid w-full max-w-6xl grid-cols-1 items-start gap-10 text-left md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <a href="#top" class="font-instrument-serif text-3xl italic text-white transition-opacity hover:opacity-75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">{siteConfig.name}</a>
        <p class="mt-3 text-sm text-cyan-100/55">{siteConfig.descriptor}</p>
      </div>

      <nav aria-label="Footer navigation" class="grid grid-cols-2 gap-x-8 gap-y-3 text-xs font-bold uppercase tracking-[0.14em] text-cyan-100/70">
        {navigation.map((item) => (
          <a href={item.href} class="transition-colors hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">{item.label}</a>
        ))}
      </nav>

      <div>
        <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.18em] text-cyan-300/45">Social</p>
        <div class="flex flex-wrap gap-5 text-sm text-cyan-100/65">
          {socialLinks.map((social) => social.href ? (
            <a href={social.href} target="_blank" rel="noreferrer" class="transition-colors hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">{social.label}</a>
          ) : (
            <span class="cursor-not-allowed text-cyan-100/35" title="Social profile link to be added">{social.label}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-12 flex w-full max-w-6xl flex-col gap-5 border-t border-white/10 pt-6 text-[10px] uppercase tracking-[0.14em] text-cyan-100/35 sm:flex-row sm:items-center sm:justify-between">
      <span>© {siteConfig.year} {siteConfig.name}</span>
      <button onclick="cookieManager.openSettings()" class="w-fit uppercase tracking-[0.14em] transition-colors hover:text-cyan-100/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Cookie Settings</button>
    </div>
  </div>
</footer>
